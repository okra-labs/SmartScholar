NODE_ENV=development
PORT=8080
SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_PATH=./data/smartscholar.sqlite
APP_BASE_URL=http://localhost:8080

# Configure an SMTP provider for real verification and password-reset emails. Production startup requires these values.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=SmartScholar <no-reply@example.com>

# Optional backup directory (keep outside public web root)
BACKUP_DIR=./backups
